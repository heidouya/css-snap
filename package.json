{
  "name": "css-snap",
  "description": "点选网页元素，查看并复制 CSS 样式",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
